<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.evaluacion2.controllers.ConsultaClientesController"
      onKeyPressed="#manejarTecla" spacing="16" styleClass="pantalla" stylesheets="@styles.css"
      prefWidth="960" prefHeight="720">
    <Label text="Consultar clientes" styleClass="titulo"/>
    <Label text="Haz doble clic sobre un cliente para ver su información." styleClass="nota"/>
    <TableView fx:id="clientesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nombreColumn" text="Nombre completo" prefWidth="250" minWidth="160"/>
            <TableColumn fx:id="tipoColumn" text="Tipo de cliente" prefWidth="140" minWidth="110"/>
            <TableColumn fx:id="ciudadColumn" text="Ciudad" prefWidth="130" minWidth="95"/>
            <TableColumn fx:id="fechaColumn" text="Fecha de nacimiento" prefWidth="175" minWidth="160"/>
            <TableColumn fx:id="solicitudColumn" text="Tipo de solicitud" prefWidth="150" minWidth="125"/>
        </columns>
        <placeholder><Label text="No hay clientes registrados. Registra uno desde el menú principal."/></placeholder>
    </TableView>
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label fx:id="cantidadLabel" text="Clientes registrados: 0" styleClass="nota"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Volver" onAction="#volver" styleClass="secundario"/>
        <Button text="Ver detalle" onAction="#verDetalle"/>
    </HBox>
</VBox>
